#########################################
# Application
# This file is plain configuration only — no credentials/API keys/tokens. Those live in
# config/secrets/qa.secrets.json (see config/secretsLoader.ts and config/secrets/README.md).
#########################################

BASE_URL=https://eventhub.rahulshettyacademy.com
API_BASE_URL=https://api.eventhub.rahulshettyacademy.com/api
TEST_DATA_FORMAT=json

#########################################
# Browser
#########################################

HEADLESS=false

# How many web spec files run in parallel Chrome sessions. 1 = serial.
WEB_MAX_INSTANCES=2

#########################################
# Execution
#########################################

DEFAULT_TIMEOUT=60000
EXPECT_TIMEOUT=10000

#########################################
# Mobile - Android
# What's under test is picked automatically (no config-file edit needed) by which of these are set:
#   ANDROID_APP_PATH set                        -> native app, installed fresh from this .apk
#                                                   (just the filename, e.g. myapp.apk — drop the
#                                                   file in apps/, see apps/README.md; no need to
#                                                   write the "apps/" prefix yourself)
#   ANDROID_APP_PACKAGE + ANDROID_APP_ACTIVITY  -> native app, already installed (no ANDROID_APP_PATH)
#   neither                                     -> mobile web (Chrome) — current default
#
# ANDROID_UDIDS empty = single device, addressed by ANDROID_DEVICE_NAME below.
# ANDROID_UDIDS="emulator-5554,emulator-5556" = one session per UDID, run in parallel
# (devices/emulators must already be booted — check with `adb devices`).
#
# ANDROID_PLATFORM_VERSION only applies in single-device mode (ANDROID_UDIDS empty) — leave it
# empty when using ANDROID_UDIDS, each UDID already pins its own OS version.
#########################################

ANDROID_PLATFORM_NAME=Android
ANDROID_AUTOMATION_NAME=UiAutomator2
ANDROID_DEVICE_NAME=Android
ANDROID_PLATFORM_VERSION=
ANDROID_UDIDS=emulator-5554,emulator-5556
ANDROID_APP_PACKAGE=com.swaglabsmobileapp
ANDROID_APP_ACTIVITY=.MainActivity
ANDROID_APP_PATH=swaglabs.apk

#########################################
# Mobile - iOS
# What's under test is picked automatically (no config-file edit needed) by which of these are set:
#   IOS_APP_PATH set                    -> native app, installed fresh from this .app/.ipa
#                                          (just the filename, e.g. MyApp.app — drop the file in
#                                          apps/, see apps/README.md; no need to write the
#                                          "apps/" prefix yourself)
#   IOS_BUNDLE_ID                       -> native app, already installed (no IOS_APP_PATH)
#   neither                             -> mobile web (Safari) — current default
#
# IOS_UDIDS empty = single device, addressed by IOS_DEVICE_NAME below.
# IOS_UDIDS="<udid-1>,<udid-2>" = one session per UDID, run in parallel
# (simulators/devices must already be booted — check with `xcrun simctl list devices booted`).
#
# IOS_PLATFORM_VERSION only applies in single-device mode (IOS_UDIDS empty) — leave it empty when
# using IOS_UDIDS, each UDID already pins its own OS version.
#########################################

IOS_PLATFORM_NAME=iOS
IOS_AUTOMATION_NAME=XCUITest
IOS_DEVICE_NAME=iPhone 17
IOS_PLATFORM_VERSION=
IOS_UDIDS=EBC85D81-B3DB-49D6-9611-0821F57A47FD,31F0D289-F162-46FD-9968-3EA7E65F9317
IOS_BUNDLE_ID=com.saucelabs.SwagLabsMobileApp
IOS_APP_PATH=swag.app

#########################################
# Mobile - execution target
# "local" (default, or unset) = local Appium server + a booted emulator/simulator, per the Android/
# iOS sections above. "browserstack" = BrowserStack App Automate (a device farm) instead — e.g. for
# CI, where no emulator/simulator is available. See config/browserstackCapabilityBuilder.ts and
# wdio.android.conf.ts / wdio.ios.conf.ts.
#
# Credentials (browserstackUsername/browserstackAccessKey) come from config/secrets/qa.secrets.json
# ONLY — never put them here. Everything below is plain config (device farm choice, project/build
# naming), not sensitive.
#
# BROWSERSTACK_ANDROID_DEVICES/BROWSERSTACK_IOS_DEVICES: "DeviceName@OSVersion,DeviceName2@OSVersion2"
# — one entry runs single-device, more than one runs in parallel. Leave empty to use the built-in
# default (one Android + one iOS device).
#########################################

MOBILE_EXECUTION_TARGET=local
BROWSERSTACK_ANDROID_DEVICES=
BROWSERSTACK_IOS_DEVICES=
BROWSERSTACK_PROJECT_NAME=wdio-hybrid-framework
BROWSERSTACK_BUILD_NAME=

#########################################
# Logging
#########################################

LOG_LEVEL=info
