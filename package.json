{
  "name": "wdio-hybrid-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "pretest:web": "rm -rf allure-results",
    "test:web": "wdio run ./config/wdio.web.conf.ts",
    "pretest:api": "rm -rf allure-results",
    "test:api": "wdio run ./config/wdio.api.conf.ts",
    "pretest:android": "rm -rf allure-results",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "pretest:ios": "rm -rf allure-results",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "pretest:all": "rm -rf allure-results",
    "test:all": "npm run test:web && npm run test:api && npm run test:android && npm run test:ios",
    "pretest:parallel": "rm -rf allure-results",
    "test:parallel": "concurrently --names \"web,api,android,ios\" -c \"blue,green,yellow,magenta\" \"wdio run ./config/wdio.web.conf.ts\" \"wdio run ./config/wdio.api.conf.ts\" \"wdio run ./config/wdio.android.conf.ts\" \"wdio run ./config/wdio.ios.conf.ts\"",
    "smoke": "wdio run ./config/wdio.web.conf.ts --mochaOpts.grep @smoke",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open allure-report",
    "allure-report": "npm run allure:generate && npm run allure:open",
    "data:build-excel": "node scripts/generateExcelFixtures.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anudeep-gubba/wdio-hybrid-framework.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/anudeep-gubba/wdio-hybrid-framework/issues"
  },
  "homepage": "https://github.com/anudeep-gubba/wdio-hybrid-framework#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/xlsx": "^0.0.35",
    "@wdio/allure-reporter": "^9.30.1",
    "@wdio/appium-service": "^9.30.1",
    "@wdio/browserstack-service": "^9.33.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "allure-commandline": "^2.43.0",
    "appium": "^3.6.0",
    "appium-chromium-driver": "^3.0.8",
    "appium-uiautomator2-driver": "^8.2.2",
    "appium-xcuitest-driver": "^12.3.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "expect-webdriverio": "^5.7.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0"
  }
}
