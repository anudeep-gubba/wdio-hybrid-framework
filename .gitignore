# ======================================================
# Dependencies
# ======================================================
node_modules/

# ======================================================
# Environment Variables
# ======================================================
# config/environments/*.env is plain configuration (URLs, timeouts, device names) — no secrets
# belong here (see Secrets section below). Still gitignored as a blanket rule regardless, so a
# secret accidentally added here later doesn't get committed by default. Only the .example
# templates are tracked; copy one to the real filename and adjust locally/in CI.
.env
.env.*
config/environments/*.env
!config/environments/*.env.example

# ======================================================
# Secrets
# ======================================================
# config/secrets/<env>.secrets.json holds real credentials/API keys/etc. — see
# config/secretsLoader.ts and src/data/credentialOverrides.ts. Only the .example templates
# (placeholder values) are tracked; copy one to the real filename and fill in real values
# locally, or populate the real file from a CI secret / secrets manager instead.
config/secrets/*.json
!config/secrets/*.secrets.example.json

# ======================================================
# WebdriverIO / Appium
# ======================================================
wdio-logs/
*.apk
*.ipa
*.app/
# apps/ holds native app builds locally (see apps/README.md) — never committed.
apps/*
!apps/README.md

# ======================================================
# Allure
# ======================================================
allure-results/
allure-report/

# ======================================================
# Coverage
# ======================================================
coverage/
.nyc_output/

# ======================================================
# Build Output
# ======================================================
dist/
build/
out/

# ======================================================
# Logs
# ======================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ======================================================
# TypeScript
# ======================================================
*.tsbuildinfo

# ======================================================
# IDE
# ======================================================
.idea/
*.iml

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# ======================================================
# Cache
# ======================================================
.cache/
tmp/
temp/

# ======================================================
# Package Managers
# ======================================================
.pnpm-store/
.npm/
.yarn/

# ======================================================
# OS Files
# ======================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# ======================================================
# Misc
# ======================================================
*.bak
*.swp
*.swo
